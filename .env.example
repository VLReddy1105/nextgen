# Development defaults are in .env.development; .env.local is optional.
# Production: explicitly set all four values in deployment environment.
# URLs and anon/publishable key are PUBLIC. Never put service-role keys,
# access/refresh tokens or database credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
